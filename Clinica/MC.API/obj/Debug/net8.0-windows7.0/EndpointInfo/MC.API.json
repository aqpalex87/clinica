  "paths": {
    "/api/acceso": {
      "post": {
        "tags": [
          "Access"
        ],
        "summary": "Método para autenticar al usuario y generar token de sesión",
        "parameters": [
          {
            "name": "X-AppKey",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-AppCode",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Objeto con correo, nombre y codigo del usuario",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MC.API.Models.AuthAccessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ok - Retorna objeto con los datos del token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MC.API.Models.AuthAccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Solicitud Errada o contenido incorrecto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SAR.API.Models.ResponseError"
                }
              }
            }
          },
          "500": {
            "description": "Server Error - Errores no controlados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SAR.API.Models.ResponseError"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway - Servidor remoto sin conexión o no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SAR.API.Models.ResponseError"
                }
              }
            }
          }
        }
      }
    },
